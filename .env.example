# Copy to `.env` (repo root) and fill in real values. `.env` is git-ignored.
# Every service loads `<service>/.env` first, then this root `.env`.
# Variables already set in the real environment always win.

# ---------- AWS (api-server, build-server, s3-reverse-proxy) ----------
# Leave the keys empty when running with an IAM role (e.g. ECS task role).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=

# ---------- ECS (api-server) ----------
CLUSTER=
TASK=
ECS_CONTAINER_NAME=build-server-img
# Comma-separated lists
ECS_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUPS=sg-xxxxxxxx

# ---------- Postgres / Prisma (api-server) ----------
# Prisma CLI reads this from api-server/.env, so put it there (or export it).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# ---------- Kafka (api-server, build-server) ----------
KAFKA_BROKERS=host:port
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_LOGS_TOPIC=container-logs
# CA certificate: either a path to the PEM file (relative to the service folder)...
KAFKA_CA_PATH=kafka.pem
# ...or the PEM contents inline (use \n for newlines). Takes precedence over KAFKA_CA_PATH.
KAFKA_CA_CERT=

# ---------- ClickHouse (api-server) ----------
CLICKHOUSE_HOST=https://host:8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# ---------- Ports ----------
PORT=9000
SOCKET_PORT=9002
PROXY_PORT=8000
# Optional override for the proxy target (defaults to https://$BUCKET_NAME.s3.$AWS_REGION.amazonaws.com/__outputs)
S3_BASE_URL=

# ---------- build-server (set per task by api-server; only needed for local testing) ----------
GIT_REPOSITORY_URL=
PROJECT_ID=
DEPLOYEMENT_ID=
